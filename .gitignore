# ============================================================
# FinJourney — .gitignore
# Cobre: .NET/C#, Visual Studio, Rider, VS Code, OS files
# ============================================================

# ------------------------------------------------------------
# Arquivos Pessoais
# ------------------------------------------------------------

//Notes.md

# ------------------------------------------------------------
# .NET / C# Build Output
# ------------------------------------------------------------
bin/
obj/
out/
publish/
*.dll
*.exe
*.pdb
*.mdb
*.cache
*.suo
*.user
*.userosscache
*.sln.docstates

# NuGet
*.nupkg
*.snupkg
.nuget/
packages/
project.lock.json
project.fragment.lock.json
artifacts/

# MSBuild
*.binlog

# dotnet tools
.config/dotnet-tools.json


# ------------------------------------------------------------
# Entity Framework Core
# ------------------------------------------------------------
# Nunca ignore a pasta Migrations — ela deve ir pro repositório
# Mas ignore snapshots temporários gerados localmente
*.ef.cache


# ------------------------------------------------------------
# Secrets e Configurações Locais
# ------------------------------------------------------------
appsettings.Local.json
appsettings.Development.json
appsettings.Staging.json
secrets.json
*.pfx
*.p12
*.key
*.cer
*.crt

# User Secrets do .NET
%APPDATA%/Microsoft/UserSecrets/
~/.microsoft/usersecrets/


